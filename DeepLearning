dos\n","np.random.seed(42)\n","N = 10000 # Gerando 10.000 pontos aleatórios\n","X = np.random.uniform(-1, 1, (N, 2))\n","Y = np.zeros(N)"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"jRYgC3-VODjw"},"outputs":[],"source":["# Classificação baseada na geometria das interseções\n","for i in range(N):\n","    x1, x2 = X[i, 0], X[i, 1]\n","\n","    # Verifica pertinência aos círculos\n","    c1 = (x1 - 1)**2 + x2**2 <= 1\n","    c2 = (x1 + 1)**2 + x2**2 <= 1\n","    c3 = x1**2 + (x2 - 1)**2 <= 1\n","    c4 = x1**2 + (x2 + 1)**2 <= 1\n","\n","    # Define as classes com base nas interseções\n","    if c1 and c3:   Y[i] = 0 # Classe 0 (Q1)\n","    elif c2 and c3: Y[i] = 1 # Classe 1 (Q2)\n","    elif c2 and c4: Y[i] = 2 # Classe 2 (Q3)\n","    elif c1 and c4: Y[i] = 3 # Classe 3 (Q4)\n","    else:           Y[i] = 4 # Classe 5 (Não interseção)\n","\n","# Separação: Treinamento (80%) e Validação (20%)\n","X_train, X_val, y_train, y_val = train_test_split(X, Y, test_size=0.2, random_state=42)\n","\n","# One-hot encoding para as variáveis alvo (exigência da função Softmax)\n","y_train_cat = to_categorical(y_train, num_classes=5)\n","y_val_cat = to_categorical(y_val, num_classes=5)"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":25469,"status":"ok","timestamp":1776174362910,"user":{"displayName":"GUSTAVO CARVALHO","userId":"03469823815789728337"},"user_tz":180},"id":"J4QTEAL1ODep","outputId":"a78d3b6c-8bda-4cca-879a-6cb0fd19d4bb"},"outputs":[{"name":"stderr","output_type":"stream","text":["/usr/local/lib/python3.12/dist-packages/keras/src/layers/core/dense.py:106: UserWarning:\n","\n","Do not pass an `input_shape`/`input_dim` argument to a layer. When using Sequential models, prefer using an `Input(shape)` object as the first layer in the model instead.\n","\n"]},{"name":"stdout","output_type":"stream","text":["Iniciando o treinamento da rede neural...\n","Treinamento concluído!\n","\n"]}],"source":["# MLP\n","model = Sequential([\n","    Dense(64, input_dim=2, activation='relu'),\n","    Dense(32, activation='relu'),\n","    Dense(5, activation='softmax')\n","])\n","\n","model.compile(optimizer=Adam(learning_rate=0.01),\n","              loss='categorical_crossentropy',\n","              metrics=['accuracy'])\n","\n","print(\"Iniciando o treinamento da rede neural...\")\n","history = model.fit(X_train, y_train_cat,\n","                    validation_data=(X_val, y_val_cat),\n","                    epochs=50, batch_size=64, verbose=0)\n","print(\"Treinamento concluído!\\n\")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":746,"status":"ok","timestamp":1776174363660,"user":{"displayName":"GUSTAVO CARVALHO","userId":"03469823815789728337"},"user_tz":180},"id":"Lw8sVNtWOXpQ","outputId":"e28d7c2a-8208-434d-efc9-dfcd6654a316"},"outputs":[{"name":"stdout","output_type":"stream","text":["\u001b[1m63/63\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m0s\u001b[0m 3ms/step\n","=== RELATÓRIO DE CLASSIFICAÇÃO (Validação) ===\n","              precision    recall  f1-score   support\n","\n","    Classe 0       0.96      1.00      0.98       278\n","    Classe 1       0.97      0.99      0.98       285\n","    Classe 2       0.99      0.98      0.98       277\n","    Classe 3       0.98      0.95      0.96       274\n","    Classe 4       0.97      0.97      0.97       886\n","\n","    accuracy                           0.97      2000\n","   macro avg       0.97      0.98      0.97      2000\n","weighted avg       0.97      0.97      0.97      2000\n","\n"]}],"source":["# Avaliação de Desempenho\n","\n","# Predições sobre o conjunto de validação\n","y_pred_probs = model.predict(X_val)\n","y_pred = np.argmax(y_pred_probs, axis=1)\n","\n","# Acurácia, Precisão, Recall e F1-Score\n","print(\"=== RELATÓRIO DE CLASSIFICAÇÃO (Validação) ===\")\n","# O classification_report do Scikit-Learn já calcula e formata Acurácia, Precision, Recall e F1-Score\n","report = classification_report(y_val, y_pred, target_names=['Classe 0', 'Classe 1', 'Classe 2', 'Classe 3', 'Classe 4'])\n","print(report)\n","\n","# Matriz de Confusão\n","cm = confusion_matrix(y_val, y_pred)"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":607},"executionInfo":{"elapsed":2813,"status":"ok","timestamp":1776174366486,"user":{"displayName":"GUSTAVO CARVALHO","userId":"03469823815789728337"},"user_tz":180},"id":"Txp6L335Sw3z","outputId":"f7fcd7a1-b2aa-475d-e37a-a13be278379d"},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1600x600 with 3 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["# Visualização dos Dados e Matriz\n","\n","fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(16, 6))\n","\n","# Dados Gerados (Scatter Plot)\n","scatter = ax1.scatter(X[:, 0], X[:, 1], c=Y, cmap='Set1', s=5, alpha=0.8)\n","ax1.set_title('Distribuição Original das 5 Classes')\n","ax1.set_xlim([-1, 1])\n","ax1.set_ylim([-1, 1])\n","ax1.set_xlabel('X1')\n","ax1.set_ylabel('X2')\n","legend1 = ax1.legend(*scatter.legend_elements(), title=\"Classes\")\n","ax1.add_artist(legend1)\n","ax1.grid(True, linestyle='--', alpha=0.5)\n","\n","# Matriz de Confusão\n","sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', ax=ax2,\n","            xticklabels=['C0', 'C1', 'C2', 'C3', 'C4'],\n","            yticklabels=['C0', 'C1', 'C2', 'C3', 'C4'])\n","ax2.set_title('Matriz de Confusão (Conjunto de Validação)')\n","ax2.set_xlabel('Predito pela Rede')\n","ax2.set_ylabel('Rótulo Real (True)')\n","\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"markdown","metadata":{"id":"cJ4dBRL4S4qK"},"source":[]},{"cell_type":"code","execution_count":null,"metadata":{"id":"8z-MBoFNOmVI"},"outputs":[],"source":["import numpy as np\n","import matplotlib.pyplot as plt\n","from tensorflow.keras.models import Sequential\n","from tensorflow.keras.layers import Dense\n","from tensorflow.keras.optimizers import Adam\n","from sklearn.metrics import mean_squared_error"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"waLBMmNfOmQQ"},"outputs":[],"source":["# Geração da Série Temporal\n","\n","np.random.seed(42)\n","N_samples = 3000\n","beta = 0.5\n","\n","# v(n): Ruído branco gaussiano, média 0, variância 1\n","v = np.random.normal(0, 1, N_samples)\n","\n","# x(n): Inicialização e cálculo da série\n","x = np.zeros(N_samples)\n","for n in range(2, N_samples):\n","    x[n] = v[n] + beta * v[n-1] * v[n-2]"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"hKYkD056OmOA"},"outputs":[],"source":["# Construção da Janela Deslizante\n","\n","# Queremos prever x(n+1) usando [x(n), x(n-1), x(n-2), x(n-3)]\n","X_data = []\n","Y_data = []\n","\n","# Começamos em n=3 para termos acesso a n-3, n-2, n-1 e n.\n","for n in range(3, len(x) - 1):\n","    # Entradas: [x(n), x(n-1), x(n-2), x(n-3)]\n","    janela_entrada = [x[n], x[n-1], x[n-2], x[n-3]]\n","    # Saída/Target: x(n+1)\n","    alvo = x[n+1]\n","\n","    X_data.append(janela_entrada)\n","    Y_data.append(alvo)\n","\n","X_data = np.array(X_data)\n","Y_data = np.array(Y_data)"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"wvmVf04YOmLw"},"outputs":[],"source":["# Divisão em Treino e Teste\n","\n","# Em séries temporais, não embaralhar os dados\n","# para manter a ordem cronológica intacta e prever o \"futuro\" real.\n","split_ratio = 0.8\n","split_idx = int(len(X_data) * split_ratio)\n","\n","X_train, X_test = X_data[:split_idx], X_data[split_idx:]\n","Y_train, Y_test = Y_data[:split_idx], Y_data[split_idx:]"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":17538,"status":"ok","timestamp":1776174384066,"user":{"displayName":"GUSTAVO CARVALHO","userId":"03469823815789728337"},"user_tz":180},"id":"Dh-qSBu7O55h","outputId":"b2248092-ba7b-4c0d-9cc2-aae0c87dddf5"},"outputs":[{"name":"stderr","output_type":"stream","text":["/usr/local/lib/python3.12/dist-packages/keras/src/layers/core/dense.py:106: UserWarning:\n","\n","Do not pass an `input_shape`/`input_dim` argument to a layer. When using Sequential models, prefer using an `Input(shape)` object as the first layer in the model instead.\n","\n"]},{"name":"stdout","output_type":"stream","text":["Treinando a MLP para previsão da série...\n"]}],"source":["# MLP\n","model = Sequential([\n","    Dense(32, input_dim=4, activation='relu'),\n","    Dense(16, activation='relu'),\n","    Dense(1, activation='linear')\n","])\n","\n","model.compile(optimizer=Adam(learning_rate=0.005), loss='mse')\n","\n","print(\"Treinando a MLP para previsão da série...\")\n","history = model.fit(X_train, Y_train,\n","                    epochs=50,\n","                    batch_size=32,\n","                    validation_data=(X_test, Y_test),\n","                    verbose=0)"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":249,"status":"ok","timestamp":1776174384319,"user":{"displayName":"GUSTAVO CARVALHO","userId":"03469823815789728337"},"user_tz":180},"id":"mKs1JGt7O53A","outputId":"efa8465e-8fb9-482c-b0e6-356a22af8362"},"outputs":[{"name":"stdout","output_type":"stream","text":["--------------------------------------------------\n","-> Limite Teórico Mínimo do MSE (Variância do Ruído v): 1.0000\n","-> Erro (MSE) alcançado pela Rede Neural no Teste: 1.1084\n","--------------------------------------------------\n"]}],"source":["# Avaliação e Cálculo do Erro e(n+1)\n","\n","Y_pred = model.predict(X_test, verbose=0).flatten()\n","\n","# Erro de predição: e(n+1) = x(n+1) - x_pred(n+1)\n","erro_predicao = Y_test - Y_pred\n","mse_teste = mean_squared_error(Y_test, Y_pred)\n","\n","print(\"-\" * 50)\n","print(f\"-> Limite Teórico Mínimo do MSE (Variância do Ruído v): 1.0000\")\n","print(f\"-> Erro (MSE) alcançado pela Rede Neural no Teste: {mse_teste:.4f}\")\n","print(\"-\" * 50)"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"executionInfo":{"elapsed":578,"status":"ok","timestamp":1776174384900,"user":{"displayName":"GUSTAVO CARVALHO","userId":"03469823815789728337"},"user_tz":180},"id":"aLRbOi-VS46m","outputId":"3733fe88-1901-4bd3-c184-c5766eae0831"},"outputs":[{"name":"stderr","output_type":"stream","text":["<>:12: SyntaxWarning:\n","\n","invalid escape sequence '\\h'\n","\n","<>:12: SyntaxWarning:\n","\n","invalid escape sequence '\\h'\n","\n","/tmp/ipykernel_2664/1353510938.py:12: SyntaxWarning:\n","\n","invalid escape sequence '\\h'\n","\n"]},{"data":{"image/png":"\n","text/plain":["<Figure size 1400x800 with 2 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["# Plotagem dos Resultados\n","\n","fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(14, 8), sharex=True)\n","\n","# Vamos plotar apenas 100 amostras para visualização\n","zoom_inicio = 100\n","zoom_fim = 200\n","tempo = np.arange(zoom_inicio, zoom_fim)\n","\n","# Curva da Série Temporal e Predição\n","ax1.plot(tempo, Y_test[zoom_inicio:zoom_fim], label='Série Real $x(n+1)$', color='blue', marker='o', markersize=4)\n","ax1.plot(tempo, Y_pred[zoom_inicio:zoom_fim], label='Predição $\\hat{x}(n+1)$', color='red', linestyle='--')\n","ax1.set_title('Série Temporal vs. Predição da Rede Neural')\n","ax1.set_ylabel('Amplitude')\n","ax1.legend()\n","ax1.grid(True, alpha=0.4)\n","\n","# Curva do Erro de Predição e(n+1)\n","ax2.plot(tempo, erro_predicao[zoom_inicio:zoom_fim], label='Erro de Predição $e(n+1)$', color='purple')\n","ax2.axhline(0, color='black', linestyle='--', linewidth=1)\n","ax2.set_title('Curva do Erro de Predição $e(n+1)$')\n","ax2.set_xlabel('Amostras (n)')\n","ax2.set_ylabel('Erro')\n","ax2.legend()\n","ax2.grid(True, alpha=0.4)\n","\n","plt.tight_layout()\n","plt.show()"]}],"metada